# Vidfetch deployment template.
#
# Local `docker compose up` does NOT need this file: docker-compose.yml ships
# development defaults for the bundled PostgreSQL container and local accounts.
#
# Use this file for:
#   - the backend-only deployment (docker-compose.backend.yml)
#   - documenting the values the separately hosted frontend needs
#
# Copy to `.env` and fill in real values. Never commit `.env`.

# ---------------------------------------------------------------------------
# Bundled PostgreSQL (docker-compose.backend.yml)
# ---------------------------------------------------------------------------
# Superuser password for the bundled database container. Required by
# docker-compose.backend.yml; use a long random value and keep it out of git.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Optional overrides for the database name and user.
# POSTGRES_DB=vidfetch
# POSTGRES_USER=vidfetch

# Connection string for host-side tooling and migrations
# (scripts/apply_migrations.py, scripts/promote_admin.py,
# scripts/create_admin.py). Compose builds its own in-network URL for the
# backend; this value is for running scripts from the host, which requires the
# commented-out db `ports:` block in docker-compose.backend.yml to be enabled
# (or run the script inside the Compose network instead).
DATABASE_URL=postgresql://vidfetch:replace-with-a-long-random-password@localhost:5432/vidfetch

# Application table schema. Defaults to public for out-of-the-box forks.
# Use a dedicated schema such as `vidfetch` if you render/apply custom
# migrations and set the same DB_SCHEMA for the backend and scripts.
DB_SCHEMA=public

# Lifetime of an opaque local-auth bearer token, in seconds.
# 2592000 = 30 days.
AUTH_SESSION_TTL_SECONDS=2592000

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
DOWNLOAD_DIR=/app/downloads
# Absolute public origin of the backend. Used for signed media/thumbnail URLs
# consumed by the separately hosted frontend, e.g. https://api.example.com.
PUBLIC_API_URL=https://api.example.com
MEDIA_TOKEN_SECRET=replace-with-a-long-random-secret
MEDIA_TOKEN_TTL_SECONDS=900
MAX_CONCURRENT_DOWNLOADS=2
MAX_CONCURRENT_JOBS_PER_USER=2
MAX_PLAYLIST_ITEMS=200
MAX_ASSET_BYTES=5368709120
MIN_FREE_DISK_MB=500
JOB_LEASE_SECONDS=300
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=https://app.example.com
ENVIRONMENT=production
LOG_LEVEL=INFO
# Keep false in production. Only enable for trusted local integration tests
# that intentionally download from a private/loopback address.
ALLOW_PRIVATE_URLS=false

# ---------------------------------------------------------------------------
# Frontend (set these in the frontend host, not in this file)
# ---------------------------------------------------------------------------
# VITE_API_BASE=https://api.example.com/api

# ---------------------------------------------------------------------------
# First-admin bootstrap (optional)
# ---------------------------------------------------------------------------
# The stack never creates a default account. Choose one of:
#
#   # from the host, with DATABASE_URL above and the backend deps installed
#   # (enable the db `ports:` block in docker-compose.backend.yml first)
#   python3 scripts/create_admin.py --email you@example.com --password '...' --admin
#
#   # or through the optional Compose profile (one run only)
#   BOOTSTRAP_ADMIN_EMAIL=you@example.com BOOTSTRAP_ADMIN_PASSWORD='...' \
#     docker compose -f docker-compose.backend.yml --profile bootstrap run --rm bootstrap
#
# To approve and promote an existing account instead:
#   DATABASE_URL=... DB_SCHEMA=public python3 scripts/promote_admin.py \
#     --email you@example.com
