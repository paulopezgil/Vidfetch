# Vidfetch v2 environment template.
# Copy to `.env` and fill in real values. Never commit `.env`.

# ---------------------------------------------------------------------------
# Supabase (hosted project or local `supabase start`)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Backend only. Never expose this to the frontend or logs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional overrides; sensible defaults derive from SUPABASE_URL.
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated
# Legacy/test HS256 secret. Prefer JWKS in production.
# SUPABASE_JWT_SECRET=

# Postgres connection string. Use the Supabase pooler in production.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
DOWNLOAD_DIR=./downloads
FRONTEND_DIST=./frontend-dist
MEDIA_TOKEN_SECRET=replace-with-a-long-random-secret
MEDIA_TOKEN_TTL_SECONDS=600
MAX_CONCURRENT_DOWNLOADS=2
MAX_CONCURRENT_JOBS_PER_USER=2
MAX_PLAYLIST_ITEMS=500
MAX_ASSET_BYTES=8589934592
MIN_FREE_DISK_MB=500
JOB_LEASE_SECONDS=120
CORS_ORIGINS=
ENVIRONMENT=development
LOG_LEVEL=INFO
# Keep false in production. Only enable for trusted local integration tests
# that intentionally download from a private/loopback address.
ALLOW_PRIVATE_URLS=false

# ---------------------------------------------------------------------------
# Frontend (Vite build-time variables)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_BASE=/api

# ---------------------------------------------------------------------------
# First-admin bootstrap (see docs/ARCHITECTURE_V2.md section 6.5)
# ---------------------------------------------------------------------------
# After the first user signs in with Google:
#   DATABASE_URL=... python3 scripts/promote_admin.py --email you@example.com
