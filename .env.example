# Vidfetch production / decoupled deployment template.
#
# Local `docker compose up` does NOT need this file: the local stack has
# development defaults in docker-compose.yml, including local Supabase.
#
# Use this file for:
#   - the VPS backend (docker-compose.prod.yml)
#   - documenting the values the Vercel frontend needs
#
# Copy to `.env` and fill in real values. Never commit `.env`.

# ---------------------------------------------------------------------------
# Supabase Cloud (production)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Backend only. Never expose this to the frontend or logs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional overrides; sensible defaults derive from SUPABASE_URL.
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated
# Legacy/test HS256 secret. Prefer JWKS in production.
# SUPABASE_JWT_SECRET=

# Postgres connection string. Use the Supabase pooler in production.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Application table schema. Defaults to public for out-of-the-box forks.
# Use a dedicated schema such as `vidfetch` if you render/apply custom
# migrations and set the same DB_SCHEMA for the backend.
DB_SCHEMA=public

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
DOWNLOAD_DIR=/app/downloads
# Absolute public origin of the backend. Used for signed media/thumbnail URLs
# consumed by the Vercel frontend, e.g. https://api.example.com.
PUBLIC_API_URL=https://api.example.com
MEDIA_TOKEN_SECRET=replace-with-a-long-random-secret
MEDIA_TOKEN_TTL_SECONDS=900
MAX_CONCURRENT_DOWNLOADS=2
MAX_CONCURRENT_JOBS_PER_USER=2
MAX_PLAYLIST_ITEMS=200
MAX_ASSET_BYTES=5368709120
MIN_FREE_DISK_MB=500
JOB_LEASE_SECONDS=300
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=https://app.example.com
ENVIRONMENT=production
LOG_LEVEL=INFO
# Keep false in production. Only enable for trusted local integration tests
# that intentionally download from a private/loopback address.
ALLOW_PRIVATE_URLS=false

# ---------------------------------------------------------------------------
# Vercel frontend (set these in the Vercel project, not in this file)
# ---------------------------------------------------------------------------
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
# VITE_API_BASE=https://api.example.com/api
# Leave VITE_ENABLE_LOCAL_AUTH unset in production.

# ---------------------------------------------------------------------------
# First-admin bootstrap (hosted Supabase)
# ---------------------------------------------------------------------------
# After the first user signs in with Google:
#   DATABASE_URL=... DB_SCHEMA=public python3 scripts/promote_admin.py \
#     --email you@example.com
