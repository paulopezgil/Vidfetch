-- Vidfetch v2.4 baseline for a standard PostgreSQL database.
--
-- Local email/password authentication replaces Supabase Auth:
--   * profiles.password_hash stores an Argon2id hash.
--   * auth_sessions stores SHA-256 hashes of opaque bearer tokens.
--
-- There is no ``auth.users`` dependency, no Supabase Auth trigger, and no
-- row-level-security role model: the FastAPI backend is the only database
-- client. Media files stay on the backend volume; the database stores paths.

-- ---------------------------------------------------------------------------
-- profiles (local users)
-- ---------------------------------------------------------------------------

create table if not exists {{schema}}.profiles (
    id              uuid primary key default gen_random_uuid(),
    email           text not null,
    password_hash   text not null,
    is_approved     boolean not null default false,
    app_role        text not null default 'user'
                    check (app_role in ('user', 'admin')),
    approved_at     timestamptz,
    approved_by     uuid references {{schema}}.profiles (id) on delete set null,
    created_at      timestamptz not null default now(),
    updated_at      timestamptz not null default now()
);

create unique index if not exists profiles_email_key
    on {{schema}}.profiles (lower(email));
create index if not exists profiles_is_approved_idx
    on {{schema}}.profiles (is_approved);
create index if not exists profiles_app_role_idx
    on {{schema}}.profiles (app_role);

-- ---------------------------------------------------------------------------
-- auth_sessions (opaque bearer tokens)
-- ---------------------------------------------------------------------------

create table if not exists {{schema}}.auth_sessions (
    id            uuid primary key default gen_random_uuid(),
    user_id       uuid not null references {{schema}}.profiles (id) on delete cascade,
    token_hash    text not null,
    user_agent    text not null default '',
    created_at    timestamptz not null default now(),
    last_used_at  timestamptz not null default now(),
    expires_at    timestamptz not null
);

create unique index if not exists auth_sessions_token_key
    on {{schema}}.auth_sessions (token_hash);
create index if not exists auth_sessions_user_idx
    on {{schema}}.auth_sessions (user_id);
create index if not exists auth_sessions_expires_idx
    on {{schema}}.auth_sessions (expires_at);

-- ---------------------------------------------------------------------------
-- media_assets: global deduplication registry
-- ---------------------------------------------------------------------------

create table if not exists {{schema}}.media_assets (
    id                    uuid primary key default gen_random_uuid(),
    canonical_id          text not null,
    extractor_key         text not null default '',
    source_url            text not null default '',
    title                 text not null default '',
    duration_seconds      integer,
    options_hash          text not null,
    options_schema_version integer not null default 1,
    format_selector       text not null default '',
    output_ext            text,
    file_path             text,
    file_size_bytes       bigint,
    file_sha256           text,
    status                text not null default 'processing'
                          check (status in ('processing', 'ready', 'failed')),
    error                 text not null default '',
    attempts              integer not null default 0,
    claimed_at            timestamptz,
    lease_until           timestamptz,
    created_at            timestamptz not null default now(),
    updated_at            timestamptz not null default now(),
    last_accessed_at      timestamptz not null default now(),
    constraint media_assets_canonical_options_key
        unique (canonical_id, options_hash),
    constraint media_assets_file_path_relative
        check (
            file_path is null
            or (
                file_path <> ''
                and file_path not like '/%'
                and position('..' in file_path) = 0
            )
        )
);

create index if not exists media_assets_status_lease_idx
    on {{schema}}.media_assets (status, lease_until);
create index if not exists media_assets_last_accessed_idx
    on {{schema}}.media_assets (last_accessed_at);
create index if not exists media_assets_canonical_idx
    on {{schema}}.media_assets (canonical_id);

-- ---------------------------------------------------------------------------
-- downloaded source playlists
-- ---------------------------------------------------------------------------

create table if not exists {{schema}}.playlists (
    id              uuid primary key default gen_random_uuid(),
    user_id         uuid not null references {{schema}}.profiles (id) on delete cascade,
    canonical_id    text not null,
    source_url      text not null default '',
    title           text not null default '',
    channel         text not null default '',
    thumbnail_path  text,
    item_count      integer not null default 0,
    options_hash    text not null,
    format_selector text not null default '',
    status          text not null default 'pending'
                    check (status in ('pending', 'downloading', 'ready', 'partial', 'failed', 'cancelled')),
    created_at      timestamptz not null default now(),
    updated_at      timestamptz not null default now(),
    constraint playlists_user_canonical_options_key
        unique (user_id, canonical_id, options_hash),
    constraint playlists_thumbnail_path_relative
        check (thumbnail_path is null or (thumbnail_path <> '' and thumbnail_path not like '/%'))
);

create index if not exists playlists_user_created_idx
    on {{schema}}.playlists (user_id, created_at desc);

-- ---------------------------------------------------------------------------
-- download_jobs: durable per-user queue and history
-- ---------------------------------------------------------------------------

create table if not exists {{schema}}.download_jobs (
    id                uuid primary key default gen_random_uuid(),
    user_id           uuid not null references {{schema}}.profiles (id) on delete cascade,
    asset_id          uuid references {{schema}}.media_assets (id) on delete set null,
    playlist_id       uuid references {{schema}}.playlists (id) on delete set null,
    kind              text not null default 'video'
                      check (kind in ('video', 'playlist', 'playlist_item')),
    source_url        text not null default '',
    title             text not null default '',
    options_hash      text not null default '',
    format_selector   text not null default '',
    idempotency_key   text,
    status            text not null default 'queued'
                      check (status in ('queued', 'resolving', 'downloading', 'processing', 'ready', 'failed', 'cancelled')),
    progress          numeric(5, 2) not null default 0
                      check (progress >= 0 and progress <= 100),
    downloaded_bytes  bigint not null default 0,
    total_bytes       bigint not null default 0,
    speed             numeric not null default 0,
    eta_seconds       integer,
    error             text not null default '',
    attempts          integer not null default 0,
    created_at        timestamptz not null default now(),
    updated_at        timestamptz not null default now(),
    started_at        timestamptz,
    completed_at      timestamptz
);

create unique index if not exists download_jobs_user_idempotency_key_idx
    on {{schema}}.download_jobs (user_id, idempotency_key)
    where idempotency_key is not null;
create index if not exists download_jobs_user_created_idx
    on {{schema}}.download_jobs (user_id, created_at desc);
create index if not exists download_jobs_status_created_idx
    on {{schema}}.download_jobs (status, created_at);
create index if not exists download_jobs_asset_idx
    on {{schema}}.download_jobs (asset_id);

-- ---------------------------------------------------------------------------
-- downloaded playlist items
-- ---------------------------------------------------------------------------

create table if not exists {{schema}}.playlist_items (
    id                uuid primary key default gen_random_uuid(),
    playlist_id       uuid not null references {{schema}}.playlists (id) on delete cascade,
    position          integer not null,
    canonical_id      text not null default '',
    source_url        text not null default '',
    title             text not null default '',
    duration_seconds  integer,
    asset_id          uuid references {{schema}}.media_assets (id) on delete set null,
    job_id            uuid references {{schema}}.download_jobs (id) on delete set null,
    status            text not null default 'pending'
                      check (status in ('pending', 'downloading', 'ready', 'failed', 'cancelled')),
    error             text not null default '',
    created_at        timestamptz not null default now(),
    updated_at        timestamptz not null default now(),
    constraint playlist_items_position_key unique (playlist_id, position)
);

create unique index if not exists playlist_items_playlist_canonical_idx
    on {{schema}}.playlist_items (playlist_id, canonical_id)
    where canonical_id <> '';
create index if not exists playlist_items_playlist_idx
    on {{schema}}.playlist_items (playlist_id, position);

-- ---------------------------------------------------------------------------
-- per-user tracks over the shared media cache
-- ---------------------------------------------------------------------------

create table if not exists {{schema}}.user_tracks (
    id              uuid primary key default gen_random_uuid(),
    user_id         uuid not null references {{schema}}.profiles (id) on delete cascade,
    asset_id        uuid not null references {{schema}}.media_assets (id) on delete cascade,
    custom_title    text not null default '',
    custom_artist   text not null default '',
    custom_album    text not null default '',
    cover_path      text,
    downloaded_at   timestamptz not null default now(),
    created_at      timestamptz not null default now(),
    updated_at      timestamptz not null default now(),
    deleted_at      timestamptz,
    constraint user_tracks_user_asset_key unique (user_id, asset_id),
    constraint user_tracks_cover_path_relative
        check (cover_path is null or (cover_path <> '' and cover_path not like '/%'))
);

create index if not exists user_tracks_user_downloaded_idx
    on {{schema}}.user_tracks (user_id, downloaded_at desc);
create index if not exists user_tracks_user_artist_idx
    on {{schema}}.user_tracks (user_id, lower(custom_artist))
    where deleted_at is null;
create index if not exists user_tracks_user_album_idx
    on {{schema}}.user_tracks (user_id, lower(custom_album))
    where deleted_at is null;

-- ---------------------------------------------------------------------------
-- curated playlists
-- ---------------------------------------------------------------------------

create table if not exists {{schema}}.user_playlists (
    id          uuid primary key default gen_random_uuid(),
    user_id     uuid not null references {{schema}}.profiles (id) on delete cascade,
    name        text not null,
    description text not null default '',
    cover_path  text,
    created_at  timestamptz not null default now(),
    updated_at  timestamptz not null default now(),
    deleted_at  timestamptz,
    constraint user_playlists_name_length
        check (length(btrim(name)) between 1 and 200),
    constraint user_playlists_cover_path_relative
        check (cover_path is null or (cover_path <> '' and cover_path not like '/%'))
);

create index if not exists user_playlists_user_updated_idx
    on {{schema}}.user_playlists (user_id, updated_at desc)
    where deleted_at is null;

create table if not exists {{schema}}.user_playlist_tracks (
    playlist_id   uuid not null references {{schema}}.user_playlists (id) on delete cascade,
    user_track_id uuid not null references {{schema}}.user_tracks (id) on delete cascade,
    position      integer not null check (position >= 0),
    added_at      timestamptz not null default now(),
    primary key (playlist_id, user_track_id),
    constraint user_playlist_tracks_position_key
        unique (playlist_id, position) deferrable initially deferred
);

create index if not exists user_playlist_tracks_track_idx
    on {{schema}}.user_playlist_tracks (user_track_id);

-- ---------------------------------------------------------------------------
-- admin audit trail
-- ---------------------------------------------------------------------------

create table if not exists {{schema}}.admin_audit_log (
    id              uuid primary key default gen_random_uuid(),
    actor_id        uuid references {{schema}}.profiles (id) on delete set null,
    action          text not null,
    target_user_id  uuid references {{schema}}.profiles (id) on delete set null,
    metadata        jsonb not null default '{}'::jsonb,
    created_at      timestamptz not null default now()
);

create index if not exists admin_audit_log_created_idx
    on {{schema}}.admin_audit_log (created_at desc);

-- ---------------------------------------------------------------------------
-- updated_at maintenance
-- ---------------------------------------------------------------------------

create or replace function {{schema}}.set_updated_at()
returns trigger
language plpgsql
as $$
begin
    new.updated_at = now();
    return new;
end;
$$;

drop trigger if exists profiles_set_updated_at on {{schema}}.profiles;
create trigger profiles_set_updated_at
    before update on {{schema}}.profiles
    for each row execute function {{schema}}.set_updated_at();

drop trigger if exists media_assets_set_updated_at on {{schema}}.media_assets;
create trigger media_assets_set_updated_at
    before update on {{schema}}.media_assets
    for each row execute function {{schema}}.set_updated_at();

drop trigger if exists download_jobs_set_updated_at on {{schema}}.download_jobs;
create trigger download_jobs_set_updated_at
    before update on {{schema}}.download_jobs
    for each row execute function {{schema}}.set_updated_at();

drop trigger if exists playlists_set_updated_at on {{schema}}.playlists;
create trigger playlists_set_updated_at
    before update on {{schema}}.playlists
    for each row execute function {{schema}}.set_updated_at();

drop trigger if exists playlist_items_set_updated_at on {{schema}}.playlist_items;
create trigger playlist_items_set_updated_at
    before update on {{schema}}.playlist_items
    for each row execute function {{schema}}.set_updated_at();

drop trigger if exists user_tracks_set_updated_at on {{schema}}.user_tracks;
create trigger user_tracks_set_updated_at
    before update on {{schema}}.user_tracks
    for each row execute function {{schema}}.set_updated_at();

drop trigger if exists user_playlists_set_updated_at on {{schema}}.user_playlists;
create trigger user_playlists_set_updated_at
    before update on {{schema}}.user_playlists
    for each row execute function {{schema}}.set_updated_at();

-- ---------------------------------------------------------------------------
-- Keep the per-user track registry in step with successful downloads
-- ---------------------------------------------------------------------------

create or replace function {{schema}}.sync_user_track_from_job()
returns trigger
language plpgsql
as $$
begin
    if new.status = 'ready' and new.asset_id is not null then
        insert into {{schema}}.user_tracks (user_id, asset_id, downloaded_at)
        values (new.user_id, new.asset_id, coalesce(new.completed_at, now()))
        on conflict (user_id, asset_id) do nothing;
    end if;
    return new;
end;
$$;

drop trigger if exists download_jobs_sync_user_track on {{schema}}.download_jobs;
create trigger download_jobs_sync_user_track
    after insert or update of status, asset_id on {{schema}}.download_jobs
    for each row execute function {{schema}}.sync_user_track_from_job();
