# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Base URL of the vidfetch API.
# - Local Compose/Vite: http://localhost:8000/api
# - Production Vercel: https://api.example.com/api
# Signed media and thumbnail URLs are resolved against this origin, so an
# absolute value also works for previews and downloads.
VITE_API_BASE=http://localhost:8000/api
