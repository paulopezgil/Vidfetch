# ---------------------------------------------------------------------------
# Supabase (browser-safe public configuration)
# ---------------------------------------------------------------------------
# Supabase project URL (public, safe for the browser).
# Local Supabase CLI: http://127.0.0.1:54321
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous/public API key. Never put a service-role key in the frontend.
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Base URL of the vidfetch API.
# - Local Compose/Vite: http://localhost:8000/api
# - Production Vercel: https://api.example.com/api
# Signed media and thumbnail URLs are resolved against this origin, so an
# absolute value also works for previews and downloads.
VITE_API_BASE=http://localhost:8000/api

# ---------------------------------------------------------------------------
# Local development only
# ---------------------------------------------------------------------------
# Enable the email/password sign-in and sign-up form on the login page. This
# lets you authenticate against a local Supabase instance without Google OAuth.
# Leave unset in production (Vercel) so Google is the only sign-in path.
VITE_ENABLE_LOCAL_AUTH=true
