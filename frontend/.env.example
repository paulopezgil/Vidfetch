# Supabase project URL (public, safe for the browser).
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous/public API key. Never put a service-role key in the frontend.
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base URL of the vidfetch API. Defaults to the same-origin /api proxy.
VITE_API_BASE=/api
